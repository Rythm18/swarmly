{
  "name": "swarmly",
  "version": "0.3.1",
  "description": "A small open-source CLI for orchestrating multi-agent Claude Code swarms. Filesystem-coordinated, no GUI, no MCP, no subscription.",
  "type": "module",
  "bin": {
    "swarmly": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run copy-assets && chmod +x dist/cli.js dist/hook.cjs",
    "copy-assets": "node -e \"const fs=require('fs'),path=require('path');fs.mkdirSync('dist/prompts',{recursive:true});for(const f of fs.readdirSync('src/prompts'))fs.copyFileSync(path.join('src/prompts',f),path.join('dist/prompts',f));fs.copyFileSync('src/hook.cjs','dist/hook.cjs');\"",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "swarm",
    "multi-agent",
    "cli",
    "orchestration"
  ],
  "author": "Ridham Khandar",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^7.0.3",
    "ink-text-input": "^6.0.0",
    "nanoid": "^5.0.9",
    "picocolors": "^1.1.1",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.15",
    "typescript": "^5.7.2"
  }
}
